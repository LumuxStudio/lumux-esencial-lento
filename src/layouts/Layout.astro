import '@fontsource-variable/syne';
import '../../tokens.css';
import '../styles/site.css';
import {site} from '../lib/site';
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><title>{site.seo.title}</title><meta name="description" content={site.seo.description}/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#282620"/><meta property="og:title" content={site.seo.title}/><meta property="og:description" content={site.seo.description}/><meta property="og:image" content={site.hero.image}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/></head><body><a class="skip" href="#contenido">Saltar al contenido</a><slot/></body></html>
