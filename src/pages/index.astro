---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import {site as s} from '../lib/site';
---
<Layout><Header/><main id="contenido">
  <section class="hero" id="inicio"><div class="hero-opening"><p class="label" data-entry="copy">Movimiento consciente. A tu ritmo.</p><h1 data-entry="title">{s.hero.lines.map(line=><span data-entry-fragment>{line}</span>)}</h1><div class="hero-invitation"><p data-entry="copy">{s.hero.description}</p><a class="text-link" href={s.hero.href}>{s.hero.cta}<span aria-hidden="true">↘</span></a></div></div><figure class="hero-photo"><img decoding="async" src={s.hero.image} srcset={`${s.hero.image.replace('.webp','-768.webp')} 768w, ${s.hero.image} 1600w`} sizes="100vw" width="1600" height="1069" alt={s.hero.alt} fetchpriority="high"/></figure><div class="photo-foot"><p>Atención / Movimiento / Pausa</p><span>Un concepto de estudio {s.brand}</span></div></section>

  <section class="practice-index section" id="practicas"><div class="section-opening"><h2 data-entry="title">{s.practices.title.split('\n').map(line=><span data-entry-fragment>{line}</span>)}</h2><p data-entry="copy">{s.practices.description}</p></div><div class="practices">{s.practices.items.map((practice,i)=><details name="lento-practicas" class="practice" id={`practica-${practice.id}`} open={i===0}><summary><span class="practice-index-number">0{i+1}</span><strong>{practice.name}</strong><span class="practice-focus">{practice.focus}</span><span class="toggle-icon" aria-hidden="true"></span></summary><div class="practice-body"><p>{practice.description}</p><div class="practice-meta"><p><span>Formato</span>{practice.format}</p><p><span>Ritmo</span>{practice.intensity}</p><a class="text-link" href="#contacto" data-pick={practice.id}>{practice.choose}<span aria-hidden="true">↗</span></a></div></div></details>)}</div></section>

  <section class="studio" id="estudio"><div class="studio-copy"><p class="label">La filosofía de {s.brand}</p><h2 data-entry="title">{s.studio.title.map(line=><span data-entry-fragment>{line}</span>)}</h2><p class="studio-intro" data-entry="copy">{s.studio.description}</p><div class="principles">{s.studio.principles.map(p=><div><h3 data-entry="copy">{p.title}</h3><p>{p.text}</p></div>)}</div><svg class="lento-lines" viewBox="0 0 250 150" role="img" aria-labelledby="lento-movement-title lento-movement-description" data-entry="gesture"><title id="lento-movement-title">Movimiento y pausa</title><desc id="lento-movement-description">Dos recorridos abiertos y un punto mandarina representan una práctica que deja espacio a la pausa.</desc><path data-motion-stroke d="M25 10v63a55 55 0 0 0 55 55h145" fill="none" stroke="currentColor" stroke-width="2"/><path data-motion-stroke d="M70 10v61a12 12 0 0 0 12 12h129" fill="none" stroke="currentColor" stroke-width="2"/><circle data-motion-dot cx="225" cy="83" r="13"/></svg></div><figure class="studio-photo"><img decoding="async" src={s.studio.image} srcset={`${s.studio.image.replace('.webp','-768.webp')} 768w, ${s.studio.image} 1400w`} sizes="(min-width:768px) 44vw, 100vw" width="1400" height="2104" alt={s.studio.alt} loading="lazy"/></figure></section>

  <section class="first-class section" id="primera-vez"><div class="first-heading"><p class="label">Un punto de partida</p><h2 data-entry="title">{s.first.title.split('\n').map(line=><span data-entry-fragment>{line}</span>)}</h2><p data-entry="copy">{s.first.intro}</p></div><ol class="first-steps">{s.first.items.map((item,i)=><li><span class="step-number" aria-hidden="true">0{i+1}</span><div><h3 data-entry="copy">{item.title}</h3><p>{item.text}</p></div></li>)}</ol></section>

  <section class="rhythms section" id="ritmos"><div class="rhythm-heading"><p class="label">Tu momento, tu ritmo</p><h2 data-entry="title">{s.rhythms.title.split('\n').map(line=><span data-entry-fragment>{line}</span>)}</h2><div class="rhythm-selector"><label for="rhythm-select">{s.rhythms.label}</label><select id="rhythm-select" disabled aria-describedby="rhythm-note">{s.rhythms.items.map(rhythm=><option value={rhythm.id}>{rhythm.name}</option>)}</select></div><p class="rhythm-note" id="rhythm-note">{s.rhythms.note}</p></div><div class="rhythm-panels" aria-live="polite">{s.rhythms.items.map((rhythm,i)=><article class="rhythm-panel" data-rhythm={rhythm.id}><span class="rhythm-index" aria-hidden="true">0{i+1}</span><h3 data-entry="copy">{rhythm.title}</h3><p>{rhythm.text}</p><a class="text-link" href={`#practica-${rhythm.practice}`} data-open-practice={rhythm.practice}>{rhythm.cta}<span aria-hidden="true">↗</span></a></article>)}</div></section>

  <section class="faq section" id="dudas"><h2 data-entry="title"><span data-entry-fragment>{s.faq.title}</span></h2><div class="faq-list">{s.faq.items.map(faq=><details name="lento-dudas"><summary>{faq.question}<span class="toggle-icon" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}</div></section>
  <Contact/>
</main><script>import '../scripts/interactions';import '../scripts/motion';</script></Layout>
